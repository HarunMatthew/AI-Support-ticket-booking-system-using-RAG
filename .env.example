# Copy this file to .env (or export these in your shell) before running the backend.

# Required for real Gemini responses. Without it, GeminiService returns a mock
# "category": "General Inquiry" response so the app still runs end-to-end.
GEMINI_API_KEY=your_gemini_api_key_here

# Only needed if endee.mock-mode=false in application.properties.
ENDEE_API_TOKEN=your_endee_api_token_here
ENDEE_BASE_URL=http://localhost:9000
